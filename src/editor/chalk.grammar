// Chalk v1 token grammar (P1-T2) — PRESENTATION ONLY (decisions D11/D12).
// Line-oriented token stream, no indentation structure: semantic nesting
// stays with the hand-rolled parser in src/lang. The drift guard in
// tests/lezer.test.ts holds this grammar to the hand lexer's token spans
// for number/color/angle/string; keywords and builtin names are separate
// node kinds so highlighting can tell them apart.
//
// Notes:
//  - Angle beats Number by maximal munch (30° / 30deg is one token, like
//    the hand lexer's).
//  - Label deliberately INCLUDES the trailing colon (Lezer tokens have no
//    lookahead); the hand lexer sees `radius` + `:` — the drift guard does
//    not compare label spans, and label-colored colons read fine.
//  - Any input yields a full-coverage tree; unknown characters (stray °,
//    bad colors) become error nodes, which only the examples must avoid.

@top Program { item* }

item {
  Number | Angle | Color | String | Label |
  Keyword | BuiltinName | Identifier | Op
}

@skip { space | LineComment }

@tokens {
  @precedence {
    LineComment, Angle, Number, Label, Keyword, BuiltinName, Identifier, Op
  }

  space { $[ \t\n\r]+ }
  LineComment { "//" ![\n]* }

  hex { $[0-9a-fA-F] }
  Number { $[0-9]+ ("." $[0-9]+)? }
  Angle { $[0-9]+ ("." $[0-9]+)? ("°" | "deg") }
  Color { "#" hex hex hex hex hex hex }
  String { '"' !["\n]* '"' }

  word { $[a-zA-Z_] $[a-zA-Z0-9_]* }
  Identifier { word }
  Label { word ":" }

  Keyword {
    "state" | "to" | "end" | "every" | "frame" | "when" | "pointer" |
    "key" | "pressed" | "released" | "moved" | "repeat" | "as" | "for" |
    "from" | "step" | "if" | "else" | "return" | "and" | "or" | "not" |
    "true" | "false" | "group"
  }

  BuiltinName {
    "paper" | "circle" | "ellipse" | "rect" | "triangle" | "line" | "random"
  }

  Op { "<=" | ">=" | "==" | "!=" | $[+\-*/<>=.,():] }
}
