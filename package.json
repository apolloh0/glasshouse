{
  "name": "glasshouse",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Phase 0 engine spike for the Glasshouse learnable programming system (Chalk language)",
  "scripts": {
    "dev": "vite apps/debug",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "UPDATE_GOLDEN=1 vitest run tests/golden",
    "bench": "PERF=1 vitest run bench",
    "typecheck": "tsc --noEmit",
    "grammar": "lezer-generator src/editor/chalk.grammar --typeScript -o src/editor/gen/chalk-parser.ts",
    "dev:studio": "vite apps/studio"
  },
  "devDependencies": {
    "@lezer/generator": "^1.8.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
